# Database Configuration (REQUIRED)
# ==============================================================================
# DATABASE_URL is REQUIRED - the application will not start without it.
#
# Format: postgresql://username:password@host:port/database
#
# For Docker Compose (connects to postgres container):
DATABASE_URL=postgresql://shopify_user:YOUR_SECURE_PASSWORD_HERE@postgres:5432/shopify_db
#
# For local development (connects to local PostgreSQL):
# DATABASE_URL=postgresql://shopify_user:YOUR_SECURE_PASSWORD_HERE@localhost:5432/shopify_db
#
# IMPORTANT: Change YOUR_SECURE_PASSWORD_HERE to a strong password!
# The password should match POSTGRES_PASSWORD below.
# ==============================================================================

# PostgreSQL container password (must match the password in DATABASE_URL above)
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# PostgreSQL Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Security - REQUIRED: Generate secure secret keys
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: The application will not start without valid SECRET_KEY and ADMIN_SECRET_KEY
SECRET_KEY=
ADMIN_SECRET_KEY=

# Token Encryption Key - REQUIRED
# Used to encrypt Shopify access tokens at rest in the database.
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you change this key after tokens are encrypted, they will become unreadable!
# Keep a backup of this key in a secure location.
ENCRYPTION_KEY=

# Environment
ENVIRONMENT=development

# API Configuration
API_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# API URLs
VITE_API_URL=http://localhost:8000

# CORS and CSRF Configuration
# Comma-separated list of allowed origins for CORS and CSRF protection.
# These origins are validated for all state-changing requests (POST, PUT, DELETE, PATCH).
# Make sure to include all frontend URLs that will access this API.
# Example for production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# Shopify API Configuration (Optional - add your credentials)
SHOPIFY_API_VERSION=2025-04
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
# Enable verbose debug logging (set to "true" for detailed debugging)
# WARNING: Debug logging may expose sensitive data and cause log bloat in production
DEBUG_LOGGING=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute

# Optional Features
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_TASK_MONITORING=true
AUTO_MIGRATE_DB=true
ENABLE_INVENTORY_VERIFICATION=true